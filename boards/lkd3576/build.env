# ============================================================================
# LKD3576 (Neardi, RK3576) 构建参数
# 由社区 rk3576_openharmony_adaptation_guide 改造而来，vendor 改用 neardi。
# ============================================================================
PRODUCT_NAME=lkd3576          # 必须和 ./build.sh --product-name 严格一致
VENDOR=neardi
BOARD=lkd3576
CHIP=rk3576
TARGET_CPU=arm64
TARGET_OS=ohos
KERNEL=linux-6.6              # 社区 rk3576 指南基于 6.6；三板保持一致最好

# ⚠️ API_VERSION 待 sync 后核真值。
#    社区 rk3568 参考写的 8 是 OH3.x 时代旧字段，6.1 应约为 20，三个 product 都要改。
API_VERSION=20

DEVICE_BUILD_PATH=device/board/neardi/lkd3576

# ---- 外围 retarget 待办（社区参考板用博通 bcmdhd_wifi6 + BCM4362A2 BT，大概率对不上）----
#   [ ] Wi-Fi 模组型号（LKD3576 实际用的模组，需查底板 BOM/原理图）
#   [ ] 音频 codec（板载 codec 型号 → DT + HDF 配置）
#   [ ] 双千兆 PHY（两路 GMAC 对应的 PHY 型号）
#   [ ] HDMI / MIPI-DSI 屏（屏参 + 背光 + 触摸屏）
