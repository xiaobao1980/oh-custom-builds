# ============================================================================
# CM3588-NAS (FriendlyElec, RK3588) 构建参数
# ⚠️ 该机当前跑 HAOS 18.3，建议【最后做】，先验证 OH 能在其它板上起来再动它。
# SOC 层 fork 应已带 rk3588（sync 后需 ls device/soc/rockchip/ 实核）。
# ============================================================================
PRODUCT_NAME=cm3588-nas
VENDOR=friendlyelec
BOARD=cm3588-nas
CHIP=rk3588
TARGET_CPU=arm64
TARGET_OS=ohos
KERNEL=linux-6.1              # FriendlyElec 6.1 内核 DT 基准；需与 fork 内核对齐
API_VERSION=20                # 待 sync 后核真值
DEVICE_BUILD_PATH=device/board/friendlyelec/cm3588-nas

# ---- 待办 ----
#   [ ] 确认 fork device_board_rockchip 是否带 rk3588 参考板；不带则完全自建
#   [ ] DT 取自 FriendlyElec 6.1 内核；U-Boot / rkbin DDR + bl31 blob 需对应
#   [ ] NAS 特性：M.2 NVMe / SATA / 多网口 按底板 retarget
#   [ ] 烧录前务必备份 HAOS 镜像，且 U-Boot + MiniLoaderAll.bin 与 CM3588 同烧
