PRODUCT_NAME=lkd3568
VENDOR=neardi
BOARD=lkd3568
CHIP=rk3568
TARGET_CPU=arm64
TARGET_OS=ohos
KERNEL=linux-6.6
API_VERSION=20                # 待 sync 后核真值
DEVICE_BUILD_PATH=device/board/neardi/lkd3568

